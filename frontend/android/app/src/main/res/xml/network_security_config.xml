<?xml version="1.0" encoding="utf-8"?>
<!-- The sync server starts out on a PC in the same Wi-Fi (plain http). Tighten this once it moves to https. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
